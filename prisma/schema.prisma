generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  dateTime   DateTime?
  pinned     Boolean   @default(false)
  favorite   Boolean   @default(false)
  tags       Tag[]     @relation("NoteTags")
  attachments Attachment[]
}

model BlogPost {
  id         String    @id @default(cuid())
  slug       String    @unique
  title      String
  content    String
  coverImage String?
  author     String?
  published  Boolean   @default(false)
  publishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tags       Tag[]     @relation("BlogTags")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  notes Note[] @relation("NoteTags")
  blogs BlogPost[] @relation("BlogTags")
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  url       String
  note      Note?    @relation(fields: [noteId], references: [id])
  noteId    String?
}
